# Keep the current production database URL for the lowest-risk migration.
DATABASE_URL="file:./data/paymentgateway.db"

# Google Cloud OAuth web client. Its redirect URI must be:
# https://api.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
# Keep the existing production value when migrating, or stored Gmail tokens become unreadable.
ENCRYPTION_KEY=

# Retained for the authenticated manual /api/cron/tick fallback.
# Generate with: openssl rand -hex 32
CRON_SECRET=

FRONTEND_URL=https://pay.example.com
API_BASE_URL=https://api.example.com

POLL_INTERVAL_SECONDS=15
WORKER_INTERVAL_SECONDS=15
ORDER_TTL_MINUTES=2
LINK_TTL_MINUTES=1440
RECONCILE_AFTER_MINUTES=45

# Optional comma-separated additions.
TRUSTED_BANK_DOMAINS=
TRUSTED_SMS_SENDERS=
TRUSTED_NOTIFICATION_APPS=
CORS_ORIGINS=
