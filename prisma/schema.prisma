generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  cancelled
}

enum WebhookStatus {
  pending
  succeeded
  failed
}

/// A user who signed in with Google. Every other row belongs to exactly one merchant, is deleted with
/// it, and is always queried with its merchantId, so one user can never see or match another's data.
model Merchant {
  id                String    @id
  email             String    @unique
  googleSub         String?   @unique @map("google_sub")
  /// AES-256-GCM encrypted Gmail refresh token; null when Gmail is not connected or access was revoked.
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailConnectedAt  DateTime? @map("gmail_connected_at")
  vpa               String?
  displayName       String?   @map("display_name")
  webhookUrl        String?   @map("webhook_url")
  /// AES-256-GCM encrypted. Stored reversibly because it is needed to sign webhook payloads.
  webhookSecret     String    @map("webhook_secret")
  /// SHA-256 of the API key. The key itself is shown once and never stored.
  apiKeyHash        String?   @unique @map("api_key_hash")
  apiKeyPrefix      String?   @map("api_key_prefix")
  apiKeyCreatedAt   DateTime? @map("api_key_created_at")
  /// Claimed before each Gmail check so concurrent requests/instances check at most once per interval.
  lastPolledAt      DateTime? @map("last_polled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  orders            Order[]
  bankTxns          BankTxn[]
  failedPayments    FailedPayment[]
  gmailMessages     GmailMessage[]
  devices           Device[]
  pairingCodes      DevicePairingCode[]
  deviceMessages    DeviceMessage[]
  sessions          Session[]
  loginCodes        LoginCode[]
  webhookDeliveries WebhookDelivery[]

  @@map("merchants")
}

/// Dashboard login session. Only the SHA-256 of the bearer token is stored.
model Session {
  id         String   @id
  merchantId String   @map("merchant_id")
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Short-lived, single-use code handed to the frontend after Google sign-in and exchanged for a session.
model LoginCode {
  codeHash     String   @id @map("code_hash")
  merchantId   String   @map("merchant_id")
  redirectPath String?  @map("redirect_path")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("login_codes")
}

model Order {
  id             String      @id
  merchantId     String      @map("merchant_id")
  /// What the merchant asked for.
  basePaise      Int         @map("base_paise")
  /// basePaise plus the unique paise offset the payer must pay.
  amountPaise    Int         @map("amount_paise")
  note           String?
  redirectUrl    String?     @map("redirect_url")
  metadata       Json?
  idempotencyKey String?     @map("idempotency_key")
  /// "failed" (no payment in time) is computed from expiresAt; only pending/paid/cancelled are stored.
  status         OrderStatus @default(pending)
  claimedUtr     String?     @map("claimed_utr")
  /// Set once the order.failed webhook has been queued, so it is sent at most once.
  failureNotifiedAt DateTime? @map("failure_notified_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")
  expiresAt      DateTime    @map("expires_at")
  paidAt         DateTime?   @map("paid_at")
  cancelledAt    DateTime?   @map("cancelled_at")

  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  txn               BankTxn?
  webhookDeliveries WebhookDelivery[]

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, status, amountPaise])
  @@index([merchantId, claimedUtr])
  @@index([merchantId, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

enum Channel {
  email
  sms
  notification
}

/// A verified credit parsed from a bank alert: an email from Gmail, or an SMS/notification from a paired phone.
model BankTxn {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  channel     Channel  @default(email)
  /// Gmail message id, or `<deviceId>:<id the phone gave the message>`.
  messageId   String   @map("message_id")
  amountPaise Int      @map("amount_paise")
  utr         String?
  payerVpa    String?  @map("payer_vpa")
  /// Who sent the alert: the email domain, SMS sender (e.g. VM-HDFCBK-S) or app package.
  bankDomain  String   @map("bank_domain")
  receivedAt  DateTime @map("received_at")
  /// A bank credit can pay at most one order.
  orderId        String?  @unique @map("order_id")
  createdAt      DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([merchantId, messageId])
  /// The same UTR can never be counted twice.
  @@unique([merchantId, utr])
  @@map("bank_txns")
}

/// A failed or reversed UPI payment reported in a bank alert. Its reference number can never pay an
/// order, so a payer who submits it is told the payment failed instead of waiting forever.
model FailedPayment {
  merchantId     String   @map("merchant_id")
  utr         String
  messageId   String   @map("message_id")
  amountPaise Int?     @map("amount_paise")
  receivedAt  DateTime @map("received_at")
  createdAt   DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, utr])
  @@map("failed_payments")
}

/// Every bank email the poller has looked at, and what it decided.
model GmailMessage {
  merchantId     String   @map("merchant_id")
  gmailMessageId String   @map("gmail_message_id")
  receivedAt     DateTime @map("received_at")
  fromAddr       String?  @map("from_addr")
  subject        String?
  verdict        String
  createdAt      DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, gmailMessageId])
  @@index([merchantId, receivedAt])
  @@map("gmail_messages")
}

/// A merchant's phone running the Android app, which forwards bank SMS and notifications as they arrive.
/// Only the SHA-256 of its token is stored; deleting the row revokes it.
model Device {
  id          String    @id
  merchantId  String    @map("merchant_id")
  name        String
  platform    String
  appVersion  String?   @map("app_version")
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime? @map("last_seen_at")

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages DeviceMessage[]

  @@index([merchantId])
  @@map("devices")
}

/// Short-lived, single-use code typed into the app to pair it with the merchant's account.
model DevicePairingCode {
  codeHash   String   @id @map("code_hash")
  merchantId String   @map("merchant_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("device_pairing_codes")
}

/// Every SMS or notification a phone sent, and what was decided. Kept after the phone is removed.
model DeviceMessage {
  /// `<deviceId>:<id the phone gave the message>`, so a retried upload is recognised.
  id         String   @id
  merchantId String   @map("merchant_id")
  deviceId   String?  @map("device_id")
  channel    Channel
  sender     String
  receivedAt DateTime @map("received_at")
  verdict    String
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([merchantId, receivedAt])
  @@map("device_messages")
}

/// Outbox of webhook events. Written in the same transaction as the change it reports, then delivered
/// with retries, so a crash between "order paid" and "webhook sent" can't lose the event.
model WebhookDelivery {
  id             String        @id
  merchantId     String        @map("merchant_id")
  orderId        String?       @map("order_id")
  event          String
  payload        Json
  status         WebhookStatus @default(pending)
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @default(now()) @map("next_attempt_at")
  lockedUntil    DateTime?     @map("locked_until")
  lastStatusCode Int?          @map("last_status_code")
  lastError      String?       @map("last_error")
  deliveredAt    DateTime?     @map("delivered_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([merchantId, createdAt])
  @@map("webhook_deliveries")
}

/// Fixed-window rate limit counters, shared across all serverless instances.
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@map("rate_limits")
}
