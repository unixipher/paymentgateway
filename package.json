{
  "name": "paymentgateway",
  "version": "1.0.0",
  "private": true,
  "description": "UPI payment gateway backend that verifies payments from bank alert emails in Gmail",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy || (sleep 20 && prisma migrate deploy); fi && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "prisma generate",
    "build:sms-headers": "node scripts/build-sms-headers.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
