{
  "name": "paymentgateway",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted UPI checkout and bank-alert reconciliation project",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "prisma generate",
    "build:sms-headers": "node scripts/build-sms-headers.ts",
    "postinstall": "prisma generate",
    "db:migrate": "tsx scripts/setup-db.ts",
    "db:setup": "tsx scripts/setup-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
