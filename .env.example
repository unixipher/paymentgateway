# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the authorised redirect URI: <BASE_URL>/auth/google/callback
BASE_URL=http://localhost:3000
PORT=3000

# Signs session cookies and encrypts stored Google refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# POLL_INTERVAL_SECONDS=15
# ORDER_TTL_MINUTES=15
# Extra bank sender domains to trust, comma separated (e.g. mybank.co.in)
# TRUSTED_BANK_DOMAINS=
