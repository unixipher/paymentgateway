# ---- Required ----

# Postgres connection string (e.g. Prisma Postgres). Use sslmode=verify-full.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=verify-full"

# Google Cloud Console → Google Auth Platform → Clients → OAuth client (Web application).
# Authorized redirect URI: <API_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts Gmail tokens and webhook secrets, and signs the OAuth state.
# Changing it disconnects every merchant's Gmail. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# The dashboard frontend. After Google sign-in the browser is sent to <FRONTEND_URL>/auth/callback?code=...
FRONTEND_URL=http://localhost:5173

# ---- Optional ----

# Public URL of this backend. Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
# API_BASE_URL=

# Protects /api/cron/tick. Vercel Cron sends it automatically. At least 16 characters.
# CRON_SECRET=

# Extra browser origins allowed to call the authenticated API (the FRONTEND_URL origin is always allowed).
# CORS_ORIGINS=https://admin.example.com

# POLL_INTERVAL_SECONDS=15
# ORDER_TTL_MINUTES=15
# Extra bank sender domains to trust, comma separated (e.g. mybank.co.in)
# TRUSTED_BANK_DOMAINS=
